# Правила для Apache — виртуальный хостинг (Spaceweb и подобные).
#
# Vite копирует содержимое public/ в dist/ при сборке, поэтому файл едет на
# сервер вместе с сайтом и ничего дописывать руками не нужно.
#
# На nginx этот файл просто лежит без дела — там свои правила, см.
# deploy/nginx.conf.example.

# Список файлов в папке наружу не отдаём
Options -Indexes

# ---------------------------------------------------------------------------
# Адреса вида /catalog/asphalt/press-lwd-5b
#
# Роутер сайта — BrowserRouter: внутри приложения такие адреса существуют, а
# на диске лежат готовые страницы, которые кладёт `npm run prerender` —
# по файлу на каждый адрес из карты сайта. Поисковый робот получает готовый
# HTML, не выполняя JavaScript; браузер посетителя поверх него запускает
# приложение как обычно.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Слеш в конце адреса Apache добавляет сам, если путь совпал с папкой на
  # диске (mod_dir, DirectorySlash). Нам это мешает: /catalog/asphalt — это
  # адрес раздела, а папка с тем же именем рядом хранит карточки товаров.
  # Без этой строки Apache уводил адрес раздела на /catalog/asphalt/, правило
  # ниже возвращало его обратно, и браузер получал бесконечный цикл
  # переадресаций вместо страницы.
  DirectorySlash Off

  # Адреса сайта пишутся без завершающего слэша — именно так они стоят в
  # карте сайта и в canonical. Вариант со слэшем — та же страница по второму
  # адресу, поэтому отправляем на основной, а не отдаём копию: для поисковика
  # два адреса с одинаковым содержимым это дубль.
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # Готовая страница для этого адреса, если она есть.
  #
  # Идёт до проверки на существующую папку, и это принципиально:
  # /catalog/asphalt — одновременно адрес раздела и папка с карточками
  # товаров внутри. Проверь мы сначала папку, Apache отдал бы её содержимое
  # вместо страницы раздела.
  #
  # Путь собираем из %{DOCUMENT_ROOT} и %{REQUEST_URI}, а не из
  # %{REQUEST_FILENAME}: когда адрес совпадает с папкой, Apache подставляет
  # в REQUEST_FILENAME путь с завершающим слешем, и проверка искала
  # несуществующий «catalog/asphalt/.html» вместо «catalog/asphalt.html».
  # Условие было ложным, правило молча не срабатывало, и страницы разделов
  # не открывались вообще.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # Настоящие файлы и папки отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Обработчик заявок — тоже настоящий файл, но лежит вне корня сайта
  RewriteRule ^api/lead$ /api/lead.php [L]

  # Адрес, для которого готовой страницы нет (например, опечатка в ссылке),
  # разбирает само приложение
  RewriteRule ^ /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Кэширование
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Имена файлов сборки содержат хеш — можно кэшировать надолго
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # Фото товаров под стабильными именами: имя файла не меняется, даже когда
  # меняется содержимое (например, после npm run images:normalize). При
  # долгом кэше браузер после переезаливки продолжает показывать старую
  # картинку — сервер её уже отдаёт новую, а браузер туда и не заходит.
  # Сутки — компромисс: не грузим сеть повторными скачиваниями каждого визита,
  # но обновление фото доезжает до посетителя в течение дня, а не месяца.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>

# Страницы кэшировать нельзя: в них ссылки на хешированные бандлы, и
# закэшированная копия будет тянуть удалённые файлы после следующей выкладки.
# Правило распространяется на все готовые страницы, а не только на index.html:
# после предрендера их 154.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Журнал заявок и настройки обработчика наружу отдавать нельзя
  <FilesMatch "\.(jsonl|env)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml

  # Ответы обработчика заявок — исключение.
  #
  # Обработчик отвечает посетителю сразу, а уведомления досылает уже после,
  # не задерживая форму. Работает это, только если браузер видит, что ответ
  # пришёл целиком. mod_deflate держит поток открытым и переписывает
  # Content-Length — браузер продолжает ждать конца скрипта, и форма снова
  # «думает» несколько секунд. Сжимать пятнадцать байт всё равно незачем.
  <IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI ^/api/ no-gzip=1
  </IfModule>
</IfModule>
