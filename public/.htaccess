# Правила для Apache — виртуальный хостинг (Spaceweb и подобные).
#
# Vite копирует содержимое public/ в dist/ при сборке, поэтому файл едет на
# сервер вместе с сайтом и ничего дописывать руками не нужно.
#
# На nginx этот файл просто лежит без дела — там свои правила, см.
# deploy/nginx.conf.example.

# ---------------------------------------------------------------------------
# Адреса вида /catalog/asphalt/press-lwd-5b
#
# Роутер сайта — BrowserRouter: таких файлов на диске нет, адрес существует
# только внутри приложения. Без правила ниже прямой заход по ссылке из поиска
# или мессенджера вернёт 404 — ломается ровно там, где больнее всего.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Настоящие файлы и папки отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Обработчик заявок — тоже настоящий файл, но лежит вне корня сайта
  RewriteRule ^api/lead$ /api/lead.php [L]

  # Всё остальное разбирает приложение
  RewriteRule ^ /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Кэширование
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Имена файлов сборки содержат хеш — можно кэшировать надолго
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # Фото товаров под стабильными именами: меняются редко, но не «никогда»
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>
</IfModule>

# index.html кэшировать нельзя: в нём ссылки на хешированные бандлы, и
# закэшированная копия будет тянуть удалённые файлы после следующей выкладки.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  # Журнал заявок и настройки обработчика наружу отдавать нельзя
  <FilesMatch "\.(jsonl|env)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
